# ==========================================
# CWebS Environment Configuration Template
# Copy this file to .env and configure your environment
# ==========================================

# Application Settings
APP_NAME=CWebS
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Use port 8111 if using custom XAMPP configuration)
DB_HOST=127.0.0.1
DB_PORT=8111
DB_NAME=accounts
DB_USER=root
DB_PASS=

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE=false
