{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 30,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "headerText": "CWebS (Custom Website Builder & CMS for Public Schools) - Codebase Pack for Gemini"
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".env",
      "*.log",
      "repomix-output.*",
      "repomix.config.json"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
